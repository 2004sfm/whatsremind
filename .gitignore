# ===================================================
# WhatsRemind — Root .gitignore
# ===================================================

# --- Agentic System (local agent symlink caches) ---
.agents/
.cursor/
.claude/

# --- Dependencies & Builds ---
node_modules/
dist/
build/
.npm
*.tsbuildinfo

# --- SQLite Databases & Cache ---
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# --- Environment Variables ---
*.env
.env*
!.env.example

# --- OS & Editors ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# --- Logs ---
*.log

# --- Temp & Scratch Files ---
temp/
